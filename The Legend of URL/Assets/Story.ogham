                "templateFields": [
                  {
                    "fields": [],
                    "template": 0
                  },
                  {
                    "fields": [
                      {
                        "key": "Mikey",
                        "mode": "Literal",
                        "templateField": "speakername",
                        "type": "Text"
                      },
                      {
                        "key": "What are you waiting for? Go on to Miss Elsie.",
                        "mode": "Literal",
                        "templateField": "text",
                        "type": "Text"
                      }
                    ],
                    "template": 1
                  }
                ],
