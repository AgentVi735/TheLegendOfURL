                ],
                "technicalName": "N0",
                "templateFields": [
                  {
                    "fields": [],
                    "template": 0
                  },
                  {
                    "fields": [
                      {
                        "key": "Mikey",
                        "mode": "Literal",
                        "templateField": "speakername",
                        "type": "Text"
                      },
                      {
                        "key": "Jeez man. I've been yelling at ya for minutes now! How dozed off were ya?",
                        "mode": "Literal",
                        "templateField": "text",
                        "type": "Text"
                      }
                    ],
                    "template": 1
                  }
                ],
                "type": "ContentNode"
              },
              {
                "displayName": "N1",
                "inputPins": [
                  {}
                ],
                "labelIds": [
                  1
                ],
                "options": [
                  {
                    "target": "N2",
                    "technicalName": "Option1",
                    "textKey": ""
                  }
                ],
                "outputPins": [
                  {}
                ],
                "position": [
                  647.421753,
                  367.917847
                ],
                "technicalName": "N1",
                "templateFields": [
                  {
                    "fields": [],
                    "template": 0
                  },
                  {
                    "fields": [
                      {
                        "key": "Rohan",
                        "mode": "Literal",
                        "templateField": "speakername",
                        "type": "Text"
                      },
                      {
                        "key": "I'm sorry Mikey. I must have been really fast asleep.",
                        "mode": "Literal",
                        "templateField": "text",
                        "type": "Text"
                      }
                    ],
                    "template": 1
                  }
                ],
                "type": "ContentNode"
              },
              {
                "displayName": "N2",
                "inputPins": [
                  {}
                ],
                "labelIds": [
                  1
                ],
                "options": [
                  {
                    "target": "N3",
                    "technicalName": "Option1",
                    "textKey": ""
                  }
                ],
                "outputPins": [
                  {}
                ],
                "position": [
                  1096.56482,
                  382.255524
                ],
                "technicalName": "N2",
                "templateFields": [
                  {
                    "fields": [],
                    "template": 0
                  },
                  {
                    "fields": [
                      {
                        "key": "Mikey",
                        "mode": "Literal",
                        "templateField": "speakername",
                        "type": "Text"
                      },
                      {
                        "key": "Anyway, Miss Elsie wanted to speak to you. She is over at her ranch, like always.",
                        "mode": "Literal",
                        "templateField": "text",
                        "type": "Text"
                      }
                    ],
                    "template": 1
                  }
                ],
                "type": "ContentNode"
              },
              {
                "displayName": "N3",
                "inputPins": [
                  {}
                ],
                "labelIds": [
                  1
                ],
                "outputPins": [
                  {}
                ],
                "position": [
                  1522.95435,
                  387.3464
                ],
                "technicalName": "N3",
                "templateFields": [
                  {
                    "fields": [],
                    "template": 0
                  },
                  {
                    "fields": [
                      {
                        "key": "Rohan",
                        "mode": "Literal",
                        "templateField": "speakername",
                        "type": "Text"
                      },
                      {
                        "key": "Thank you, Mikey.",
                        "mode": "Literal",
                        "templateField": "text",
                        "type": "Text"
                      }
                    ],
                    "template": 1
                  }
                ],
                "type": "ContentNode"
              },
              {
                "displayName": "N0.1",
                "inputPins": [
                  {}
                ],
                "labelIds": [
                  1
                ],
                "outputPins": [
                  {}
                ],
                "position": [
