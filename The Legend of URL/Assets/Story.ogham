      {
        "content": [
          {
            "content": [
              {
                "displayName": "N0",
                "inputPins": [
                  {}
                ],
                "labelIds": [
                  1
                ],
                "options": [
                  {
                    "target": "N1",
                    "technicalName": "Option1",
                    "textKey": ""
                  }
                ],
                "outputPins": [
                  {}
                ],
                "position": [
                  146.0841,
                  278.68573
                ],
                "technicalName": "N0",
                "templateFields": [
                  {
                    "fields": [],
                    "template": 0
                  },
                  {
                    "fields": [
                      {
                        "key": "",
                        "mode": "Literal",
                        "templateField": "speakername",
                        "type": "Text"
                      },
                      {
                        "key": "Within the center of these lands... Lies a prosperous kingdom... ",
                        "mode": "Literal",
                        "templateField": "text",
                        "type": "Text"
                      }
                    ],
                    "template": 1
                  }
                ],
                "type": "ContentNode"
              },
              {
                "displayName": "N1",
                "inputPins": [
                  {}
                ],
                "labelIds": [
                  1
                ],
                "options": [
                  {
                    "target": "N2",
                    "technicalName": "Option1",
                    "textKey": ""
                  }
                ],
                "outputPins": [
                  {}
                ],
                "position": [
                  634.682434,
                  289.764771
                ],
                "technicalName": "N1",
                "templateFields": [
                  {
                    "fields": [],
                    "template": 0
                  },
                  {
                    "fields": [
                      {
                        "key": "",
                        "mode": "Literal",
                        "templateField": "speakername",
                        "type": "Text"
                      },
                      {
                        "key": "...The Holy Land of Marijoa...",
                        "mode": "Literal",
                        "templateField": "text",
                        "type": "Text"
                      }
                    ],
                    "template": 1
                  }
                ],
                "type": "ContentNode"
              },
              {
                "displayName": "N2",
                "inputPins": [
                  {}
                ],
                "labelIds": [
                  1
                ],
                "options": [
                  {
                    "target": "N3",
                    "technicalName": "Option1",
                    "textKey": ""
                  }
                ],
                "outputPins": [
                  {}
                ],
                "position": [
                  1051.8457,
                  285.982941
                ],
                "technicalName": "N2",
                "templateFields": [
                  {
                    "fields": [],
                    "template": 0
                  },
                  {
                    "fields": [
                      {
                        "key": "",
                        "mode": "Literal",
                        "templateField": "speakername",
                        "type": "Text"
                      },
                      {
                        "key": "A Kingdom without a king... It serves as the Vocal point of the world and as the headquarters of the World Government...",
                        "mode": "Literal",
                        "templateField": "text",
                        "type": "Text"
                      }
                    ],
                    "template": 1
                  }
                ],
                "type": "ContentNode"
              },
              {
                "displayName": "N3",
                "inputPins": [
                  {}
                ],
                "labelIds": [
                  1
                ],
                "options": [
                  {
                    "target": "N4",
                    "technicalName": "Option1",
                    "textKey": ""
                  }
                ],
                "outputPins": [
                  {}
                ],
                "position": [
                  1468.87366,
                  286.540558
                ],
                "technicalName": "N3",
                "templateFields": [
                  {
                    "fields": [],
                    "template": 0
                  },
                  {
                    "fields": [
                      {
                        "key": "",
                        "mode": "Literal",
                        "templateField": "speakername",
                        "type": "Text"
                      },
                      {
                        "key": "My dream is to enlist into the armies of the World Government and to protect the people of the world...",
                        "mode": "Literal",
                        "templateField": "text",
                        "type": "Text"
                      }
                    ],
                    "template": 1
                  }
                ],
                "type": "ContentNode"
              },
              {
                "displayName": "N4",
                "inputPins": [
                  {}
                ],
                "labelIds": [
                  1
                ],
                "options": [
                  {
                    "target": "N5",
                    "technicalName": "Option1",
                    "textKey": ""
                  }
                ],
                "outputPins": [
                  {}
                ],
                "position": [
                  1886.21692,
                  283.4915
                ],
                "technicalName": "N4",
                "templateFields": [
                  {
                    "fields": [],
                    "template": 0
                  },
                  {
                    "fields": [
                      {
                        "key": "",
                        "mode": "Literal",
                        "templateField": "speakername",
                        "type": "Text"
                      },
                      {
                        "key": "I've been training hard to meet their expectations... But the mayor won't allow me to travel to Marijoa to enlist... He believes it's too dangerous... ",
                        "mode": "Literal",
                        "templateField": "text",
                        "type": "Text"
                      }
                    ],
                    "template": 1
                  }
                ],
                "type": "ContentNode"
              },
              {
                "displayName": "N5",
                "inputPins": [
                  {}
                ],
                "labelIds": [
                  1
                ],
                "options": [
                  {
                    "target": "N6",
                    "technicalName": "Option1",
                    "textKey": ""
                  }
                ],
                "outputPins": [
                  {}
                ],
                "position": [
                  2300.9187,
                  286.545441
                ],
                "technicalName": "N5",
                "templateFields": [
                  {
                    "fields": [],
                    "template": 0
                  },
                  {
                    "fields": [
                      {
                        "key": "",
                        "mode": "Literal",
                        "templateField": "speakername",
                        "type": "Text"
                      },
                      {
                        "key": "Instead he has me working as the blacksmith's apprentice... ",
                        "mode": "Literal",
                        "templateField": "text",
                        "type": "Text"
                      }
                    ],
                    "template": 1
                  }
                ],
                "type": "ContentNode"
              },
              {
                "displayName": "N6",
                "inputPins": [
                  {}
                ],
                "labelIds": [
                  1
                ],
                "options": [
                  {
                    "target": "N7",
                    "technicalName": "Option1",
                    "textKey": ""
                  }
                ],
                "outputPins": [
                  {}
                ],
                "position": [
                  2723.71729,
                  286.646545
                ],
                "technicalName": "N6",
                "templateFields": [
                  {
                    "fields": [],
                    "template": 0
                  },
                  {
                    "fields": [
                      {
                        "key": "",
                        "mode": "Literal",
                        "templateField": "speakername",
                        "type": "Text"
                      },
                      {
                        "key": "I will keep training until the mayor finally allows me to travel to Marijoa. No matter wha- ",
                        "mode": "Literal",
                        "templateField": "text",
                        "type": "Text"
                      }
                    ],
                    "template": 1
                  }
                ],
                "type": "ContentNode"
              },
              {
                "displayName": "N7",
                "inputPins": [
                  {}
                ],
                "labelIds": [
                  1
                ],
                "outputPins": [
                  {}
                ],
                "position": [
                  3187.535,
                  289.871582
                ],
                "technicalName": "N7",
                "templateFields": [
                  {
                    "fields": [],
                    "template": 0
                  },
                  {
                    "fields": [
                      {
                        "key": "",
                        "mode": "Literal",
                        "templateField": "speakername",
                        "type": "Text"
                      },
                      {
                        "key": "Hey, wake up!",
                        "mode": "Literal",
                        "templateField": "text",
                        "type": "Text"
                      }
                    ],
                    "template": 1
                  }
                ],
                "type": "ContentNode"
              }
