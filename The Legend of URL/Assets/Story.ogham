      {
        "content": [
          {
            "content": [
              {
                "displayName": "N0",
                "inputPins": [
                  {}
                ],
                "labelIds": [
                  1
                ],
                "options": [
                  {
                    "target": "N1",
                    "technicalName": "Option1",
