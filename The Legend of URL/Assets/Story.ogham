                ],
                "technicalName": "N7",
                "templateFields": [
                  {
                    "fields": [],
                    "template": 0
                  },
                  {
                    "fields": [
                      {
                        "key": "",
                        "mode": "Literal",
                        "templateField": "speakername",
                        "type": "Text"
                      },
                      {
                        "key": "Hey, wake up!",
                        "mode": "Literal",
                        "templateField": "text",
                        "type": "Text"
                      }
                    ],
                    "template": 1
                  }
                ],
                "type": "ContentNode"
